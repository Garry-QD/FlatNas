{
  "name": "flat-nas",
  "version": "1.2.6",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "go run ../backend",
    "server:hot": "cd ../backend && go run github.com/air-verse/air@latest -c .air.toml",
    "wait-backend": "node -e \"const base=process.env.VITE_BACKEND||'http://127.0.0.1:3000';const target=new URL('/api/system-config',base).toString();const timeoutMs=60000;const intervalMs=500;const start=Date.now();const attempt=async()=>{try{const ctrl=new AbortController();const t=setTimeout(()=>ctrl.abort(),1500);const res=await fetch(target,{signal:ctrl.signal});clearTimeout(t);if(res.ok){process.exit(0);}}catch(e){}if(Date.now()-start>timeoutMs){console.error('Backend health check timed out:',target);process.exit(1);}setTimeout(attempt,intervalMs);};attempt();\"",
    "start": "run-p server \"wait-backend && dev\"",
    "start:hot": "run-p server:hot \"wait-backend && dev\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest --environment=jsdom",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/pako": "^2.0.4",
    "@types/prismjs": "^1.26.5",
    "@types/socket.io-client": "^1.4.32",
    "@types/uuid": "^10.0.0",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "dompurify": "^3.3.1",
    "fuse.js": "^7.1.0",
    "grid-layout-plus": "^1.1.1",
    "idb": "^8.0.3",
    "lunar-javascript": "^1.7.7",
    "pako": "^2.1.0",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "smooth-corners": "^1.1.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-cropper": "^1.1.4",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^2.1.3",
    "vue-tsc": "^3.1.5"
  }
}
